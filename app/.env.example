# --- CSRF-Schutz ---------------------------------------------------------
# Komma-separierte Liste erlaubter Origin-Header für mutierende API-Requests.
# Browser-fetches aus anderen Tabs setzen Origin automatisch; was hier nicht
# steht, bekommt 403. CLI-Tools (curl, scripts) senden keinen Origin und
# bleiben unbeeinflusst.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- SSRF-Schutz für Ollama ---------------------------------------------
# Hostnames, die in der Setting "ollamaUrl" akzeptiert werden. Default ist
# nur Loopback. Für Docker-/Host-Setups z.B. "ollama,host.docker.internal"
# ergänzen.
ALLOWED_OLLAMA_HOSTS=localhost,127.0.0.1,::1
